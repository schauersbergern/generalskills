<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<title>$pagetitle$</title>
<style>
@page {
  size: A4;
  margin: 22mm 20mm 24mm 20mm;
  @bottom-center {
    content: "Seite " counter(page) " von " counter(pages);
    font-family: Helvetica, Arial, sans-serif;
    font-size: 9pt;
    color: #555555;
  }
}
html {
  font-family: -apple-system, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 10.5pt;
  line-height: 1.45;
  color: #1a1a1a;
}
body {
  margin: 0;
}
h1 {
  font-size: 20pt;
  margin: 0 0 6mm 0;
}
h2 {
  font-size: 14pt;
  margin: 8mm 0 3mm 0;
  padding-bottom: 1mm;
  border-bottom: 0.5pt solid #999999;
}
h3 {
  font-size: 11.5pt;
  margin: 6mm 0 2mm 0;
  break-after: avoid;
}
p {
  margin: 0 0 3mm 0;
}
ul {
  margin: 0 0 3mm 0;
  padding-left: 6mm;
}
table {
  border-collapse: collapse;
  margin: 0 0 4mm 0;
}
th, td {
  border: 0.5pt solid #999999;
  padding: 1.5mm 4mm;
  text-align: left;
}
th {
  background: #eeeeee;
}
hr {
  border: 0;
  border-top: 0.5pt solid #999999;
  margin: 8mm 0 3mm 0;
}
</style>
</head>
<body>
$body$
</body>
</html>
